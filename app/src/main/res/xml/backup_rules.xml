<?xml version="1.0" encoding="utf-8"?>
<!-- Kinetic Routines is offline-only: nothing is backed up by the OS. Users export encrypted backups manually. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
